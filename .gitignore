# CRM-Sales .gitignore

# Configuration files with sensitive data
config/database.php

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Log files
*.log
error_log
php_errors.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Cache and session files
cache/
sessions/
tmp/

# Vendor dependencies (if using Composer)
vendor/
composer.phar

# Environment files
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup
*.old

# System files
.DS_Store
.AppleDouble
.LSOverride
._*
